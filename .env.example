# Copie para .env.local (dev) ou defina no ambiente do build. Variáveis NEXT_PUBLIC_* vão para o HTML: não são segredo.

# Número do WhatsApp dos botões, com código do país e DDD, só dígitos. O valor abaixo é FALSO, só de teste.
NEXT_PUBLIC_WHATSAPP_NUMBER=5500000000000

# URL pública do site, sem barra no fim (canônica, og:image, sitemap). Valor de teste até o primeiro deploy:
# depois de publicar, troque pela URL real (https://autohub-site.<sua-conta>.workers.dev) e refaça o build.
NEXT_PUBLIC_SITE_URL=https://autohub.exemplo.invalid

# Indexação. Por padrão (variável ausente) a página sai com noindex, nofollow e o robots.txt com "Disallow: /",
# porque preços e textos ainda são provisórios. Só com o valor "sim" ela fica indexável e entra no sitemap.xml.
# NEXT_PUBLIC_INDEXAR=sim
